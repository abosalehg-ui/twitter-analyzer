{
  "name": "twitter-analyzer",
  "version": "3.0.0",
  "description": "Client-side bilingual (Arabic/English) single-tweet analyzer with AI-detection and X-algorithm fit scoring",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"styles/**/*.css\" \"*.html\""
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "jsdom": "^25.0.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "@vitest/coverage-v8": "^2.1.4"
  },
  "license": "MIT"
}
